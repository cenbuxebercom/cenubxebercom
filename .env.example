# Yerli işləmə üçün bu faylı .env.local adı ilə kopyalayıb doldurun.
# Vercel-də eyni dəyişənləri Project → Settings → Environment Variables bölməsinə əlavə edin.

NEXT_PUBLIC_SITE_URL=https://www.cenubxeber.com

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

IMGBB_API_KEY=

ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Əlaqə formu e-poçtu (Resend)
RESEND_API_KEY=
CONTACT_TO_EMAIL=info@cenubxeber.com
CONTACT_FROM_EMAIL=Cənub Xəbər <noreply@cenubxeber.com>

# Avto-çəkmə (AI) — pulsuz: Google AI Studio açarı
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# İstəyə bağlı ödənişli alternativ:
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
CRON_SECRET=

# E-poçt üçün alternativ: Gmail SMTP (SMTP_USER+SMTP_PASS varsa Resend əvəzinə bu istifadə olunur)
SMTP_USER=
SMTP_PASS=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
